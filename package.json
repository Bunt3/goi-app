{
  "name": "goi-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal offline-first Japanese vocabulary PWA (FSRS-6).",
  "scripts": {
    "predev": "node scripts/copy-ocr.cjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr.cjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/runthrough.cjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@tesseract.js-data/jpn": "^1.0.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
